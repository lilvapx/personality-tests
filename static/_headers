/*
  Cloudflare Pages Headers
  https://developers.cloudflare.com/pages/configuration/headers/

  Sicherheits-Header global (außer für die Worker-Route, die serverseitig rendert)
*/

/*
  Die _worker.js (SvelteKit SSR) bekommt die CSP nicht als statischen Header,
  weil sie dynamische Inline-Styles/Scripts braucht. Deshalb hier nur für statische Assets.
*/

/assets/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable

/app/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
