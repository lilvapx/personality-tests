/*
  Cloudflare Pages Headers
  https://developers.cloudflare.com/pages/configuration/headers/

  Sicherheits-Header global (außer für die Worker-Route, die serverseitig rendert)
*/

/*
  Die _worker.js (SvelteKit SSR) bekommt die CSP nicht als statischen Header,
  weil sie dynamische Inline-Styles/Scripts braucht. Deshalb hier nur für statische Assets.
*/

/assets/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable

/app/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
